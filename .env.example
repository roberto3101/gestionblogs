# Direccion de la API del CMS, tal como la alcanza el navegador.
# Vacia o sin definir, el panel llama a /api del mismo dominio, que es lo
# correcto cuando panel y API comparten servidor.
VITE_URL_BASE_API=https://blogs-codeplex.duckdns.org/api

VITE_NOMBRE_PRODUCTO=Codeplex CMS

# Con "produccion" desaparece el boton de credenciales de prueba de la
# pantalla de entrada. En un panel publicado NO puede quedarse en
# "desarrollo": seria ensenarle la cuenta de administrador a cualquiera.
VITE_AMBIENTE=desarrollo

# Sitios publicos donde se ven los posts. JSON en una sola linea.
#
# Cada elemento: { codigo, urlProduccion, rutasBlog }
# rutasBlog lleva la ruta del indice del blog EN CADA IDIOMA, porque no
# tienen por que parecerse: en AI Robotics son /recursos/articulos y
# /en/resources/articles.
#
# Se sigue aceptando la forma antigua { rutaBlog: "/es/blog" }, una sola
# plantilla con el idioma dentro, para no romper paneles ya configurados.
#
# Si se deja sin definir, se usa la lista que trae el codigo.
VITE_SITIOS_PUBLICOS_JSON=[{"codigo":"DGDWEB","urlProduccion":"https://dgdenterprice.com","rutasBlog":{"es":"/es/blog","en":"/en/blog"}},{"codigo":"AIROBOTICS","urlProduccion":"https://ai-robotics-green.vercel.app","rutasBlog":{"es":"/recursos/articulos","en":"/en/resources/articles"}}]
